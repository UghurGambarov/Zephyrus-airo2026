# Zephyrus City Trap — backend configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Optional: enables Claude-generated incident reports.
# If unset, the system falls back to the deterministic offline template.
ANTHROPIC_API_KEY=

# Backend listen port.
PORT=8010

# Comma-separated list of allowed CORS origins.
# Use the real frontend origin in production — never "*".
CORS_ALLOW_ORIGINS=http://localhost:5173

# Optional: override where sample-data.csv is read from.
# DATA_DIR=../data
